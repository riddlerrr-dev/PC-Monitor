# ---- The PC being managed ----
PC_NAME="Gaming PC"
PC_HOST=192.168.1.50          # give the PC a fixed IP (DHCP reservation) on your router
PC_SSH_PORT=22
PC_SSH_USER=youradminuser     # Windows account the SSH key is set up for
# Key auth (recommended): put the private key at ./data/ssh/id_ed25519
# PC_SSH_PASSWORD=            # or use a password instead (less secure)

# ---- First sign-in (only used when there are no accounts yet) ----
ADMIN_USERNAME=alex
ADMIN_PASSWORD=change-me-please

# ---- General ----
TZ=Europe/London
PORT=8080
POLL_SECONDS=30
CHECK_ARP=true
# ARP_INTERFACE=eth0          # only if auto-detection picks the wrong network card
SSH_FAILS_BEFORE_ALERT=4      # checks in a row before "SSH not answering" alert (4 x 30s = 2 min)
AUTH_CHECK_SECONDS=300        # how often to test a real SSH login, not just an open port
SSH_TRUST_FIRST_USE=false     # true = accept the first host key seen instead of data/known_hosts
COOKIE_SECURE=false           # true if you put it behind HTTPS
DRY_RUN=false                 # true = log commands instead of sending them (for testing)
